rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone signed in (anonymously is fine) who knows the secret plan key in the link can read and write that plan.
    // Nothing else in the database is reachable.
    match /plans/{plan}/{document=**} {
      allow read, write: if request.auth != null && plan.size() >= 20;
    }
  }
}
